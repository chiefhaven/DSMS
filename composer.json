{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "url": "https://github.com/dineshsailor/nWidart-laravel-menus",
            "type": "git"
        }
    ],
    "require": {
        "php": "^8.0",
        "aloha/twilio": "^4.0",
        "automattic/woocommerce": "^3.0",
        "barryvdh/laravel-dompdf": "^3.1",
        "composer/semver": "^3.0",
        "consoletvs/charts": "^6.5",
        "doctrine/dbal": "^3.6",
        "giggsey/libphonenumber-for-php": "^8.12",
        "guzzlehttp/guzzle": "^7.2",
        "jeroennoten/laravel-adminlte": "^3.11",
        "khanamiryan/qrcode-detector-decoder": "^2.0",
        "knox/pesapal": "1.0.0",
        "laravel/framework": "12.x",
        "laravel/legacy-factories": "^1.3",
        "laravel/sanctum": "*",
        "laravel/tinker": "^2.7",
        "laravel/ui": "4.x",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1.8",
        "mpdf/mpdf": "^8.1",
        "nwidart/laravel-modules": "^12.0",
        "pusher/pusher-php-server": "^5.0",
        "razorpay/razorpay": "2.*",
        "realrashid/sweet-alert": "^7.1",
        "sadiqsalau/laravel-otp": "^1.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/browsershot": "^5.0",
        "spatie/flysystem-dropbox": "^2.0",
        "spatie/laravel-activitylog": "^4.4",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-data": "^4.20",
        "spatie/laravel-html": "^3.5",
        "spatie/laravel-one-time-passwords": "^1.0",
        "spatie/laravel-permission": "^7.2",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^7.122",
        "tonysm/rich-text-laravel": "^3.4",
        "yajra/laravel-datatables-oracle": "12"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.4",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^2.0"
    },

    "autoload": {
        "files": [
            "app/Http/helpers.php"
        ],
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
